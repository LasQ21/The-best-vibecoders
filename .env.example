# Скопіюйте у .env і заповніть. .env у git не потрапляє.

# Токен від @BotFather
BOT_TOKEN=
# Публічна HTTPS-адреса дашборда (…/app). Порожньо — бот без дашборда.
# На Vercel можна не задавати: візьметься https://<production-домен>/app
WEBAPP_URL=
# Адміністратори (/update, /status, /demo_alert): юзернейми Telegram і/або chat_id через кому,
# наприклад: ADMIN_IDS=@bohdan,123456789 (посилання t.me/bohdan теж підійде). Адміністратор за юзернеймом має один раз
# надіслати боту /start — тоді бот дізнається його chat_id і зможе писати службові повідомлення.
ADMIN_IDS=
BOT_ENV=prod
POLL_INTERVAL_SEC=300
POLL_LIMIT=150
BOT_DB_PATH=bot_data/bot.db

# Лише для Vercel: секрет для /cron/poll і /tg/setup (довгий випадковий рядок)
CRON_SECRET=

# Розробка дашборда без Telegram (лише з BOT_ENV=dev і HOST=127.0.0.1):
# DEV_AUTH_BYPASS=1
# HOST=127.0.0.1
# PORT=8000
